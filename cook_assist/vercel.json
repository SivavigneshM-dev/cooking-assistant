{
  "version": 2,
  "builds": [
    {
      "src": "cook_assist/wsgi.py",
      "use": "@vercel/python",
      "config": { 
        "maxLambdaSize": "15mb", 
        "runtime": "python3.9",
        "moduleName": "cook_assist.wsgi" 
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "cook_assist/wsgi.py"
    }
  ]
}